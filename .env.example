# ============================================================
#  SlamBook – Environment Variable Reference
#  Copy this file to .env and fill in real values.
#  NEVER commit .env or any file containing real secrets.
# ============================================================


# ── Node / Express ───────────────────────────────────────────
# Runtime mode.  Must be "production" on Render.
NODE_ENV=production

# TCP port Express listens on.
# Render sets PORT automatically – leave this as-is for production.
# For local dev, Express defaults to 3000 if PORT is unset.
PORT=3000


# ── Admin authentication ─────────────────────────────────────
# Password required to access the admin dashboard.
# The server will REFUSE to start in production if this is missing.
# Use a long, random string – e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER use a simple word.  The old default 'anjali123' is intentionally removed.
ADMIN_PASSWORD=replace-with-a-long-random-string


# ── MongoDB Atlas ────────────────────────────────────────────
# Full connection string from Atlas → Connect → Drivers.
# The server will REFUSE to start in production if this is missing.
# Format: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/slambook?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/slambook?retryWrites=true&w=majority


# ── CORS – allowed frontend origin ──────────────────────────
# The URL of your Vercel deployment (no trailing slash).
# Example: https://slambook-anjali.vercel.app
# You may supply a comma-separated list if you have preview URLs:
# FRONTEND_URL=https://slambook-anjali.vercel.app,https://slambook-git-main-anjali.vercel.app
# Localhost is always allowed automatically in development.
FRONTEND_URL=https://your-project.vercel.app


# ── Google Drive backup (optional) ──────────────────────────
# Leave BOTH values empty to disable Drive mirroring entirely.
# The app works normally without these – entries are always saved to MongoDB.

# Web App URL from your Google Apps Script deployment (ends in /exec).
# Apps Script editor → Deploy → Manage deployments → copy the URL.
DRIVE_WEBHOOK_URL=

# Shared secret that must match SHARED_SECRET inside google-drive-backup.gs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DRIVE_SHARED_SECRET=


# ── Drive backup retry tuning ────────────────────────────────
# How long (ms) a backup must have been pending before a retry is attempted.
# Default: 300000 (5 minutes).  Lower for testing, higher to reduce noise.
DRIVE_RETRY_DELAY_MS=300000

# How often (ms) the retry sweep runs while the server is alive.
# Default: 60000 (every minute).
DRIVE_RETRY_INTERVAL_MS=60000
