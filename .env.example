# Copy this file to .env and fill in real values. Never commit .env.

# Express port (Render sets this automatically)
PORT=3000

# Passcode for /admin.html. Change this - do not ship the default 'anjali123'.
ADMIN_PASSWORD=change-me-to-something-strong

# MongoDB Atlas connection string.
# Atlas dashboard > your cluster > Connect > Drivers > copy the mongodb+srv:// URI.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/slambook?retryWrites=true&w=majority

# Google Drive backup (optional). Leave both blank to disable the mirror.
# DRIVE_WEBHOOK_URL is the Apps Script Web App URL ending in /exec.
DRIVE_WEBHOOK_URL=
# Must match SHARED_SECRET inside google-drive-backup.gs exactly.
DRIVE_SHARED_SECRET=
